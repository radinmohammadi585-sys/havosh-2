# مثال: STUDENT_1_PASSWORD=... تا STUDENT_3000_PASSWORD=...
# فقط شماره‌هایی که رمز دارند می‌توانند وارد شوند
STUDENT_1_PASSWORD=
STUDENT_2_PASSWORD=
# STUDENT_3000_PASSWORD=


OPENROUTER_API_KEY=
